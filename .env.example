# ============================================================
# YSU IR Dashboard - 환경변수 템플릿
# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요. (.env 는 커밋 금지)
#   copy .env.example .env
#
# 기본값은 이 PC에 설치된 PostgreSQL(localhost:5432)과
# Node로 직접 띄우는 백엔드/프론트엔드를 가리킵니다.
# ============================================================

# ---- Database (로컬 PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ir_user
DB_PASSWORD=ir_password
DB_DATABASE=ir_dashboard
DB_LOGGING=false

# ---- Backend ----
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# ---- SMTP (임시 비밀번호 이메일 발송) ----
# SMTP_HOST 가 비어 있으면 개발 모드에서 서버 로그로 임시 비밀번호를 출력합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yeonsung.ac.kr

# ---- 대학알리미 OpenAPI (data.go.kr / B340014 제공기관 루트) ----
DATA_GO_KR_BASE_URL=https://apis.data.go.kr/B340014
# 발급받은 서비스키(인증키)를 입력하세요.
DATA_GO_KR_KEY=YOUR_DATA_GO_KR_SERVICE_KEY_HERE

# 대학 마스터/트리 소스
ALIMI_UNIV_SERVICE=BasicInformationService_2
ALIMI_UNIV_OPERATION=getUniversityCode

# 대학별 학과정보 / 대계열 코드 (BasicInformationService_1)
ALIMI_DEPT_SERVICE=BasicInformationService_1
ALIMI_DEPT_OPERATION=getUniversityMajorCode
ALIMI_SERIES_SERVICE=BasicInformationService_1
ALIMI_SERIES_OPERATION=getCodeByLargeSeries
ALIMI_DEPT_CONCURRENCY=2

# 통계 5종 API — ALIMI_STATS_UNIV_LIMIT: 0=전체, 양수=샘플
ALIMI_STATS_UNIV_LIMIT=0
ALIMI_CALL_DELAY_MS=1200

# 매월 1일 03:00(한국시간) 최신 공개연도 자동 동기화
ALIMI_BATCH_CRON=0 0 3 1 * *
ALIMI_BATCH_TIME_ZONE=Asia/Seoul
ALIMI_YEAR_LOOKBACK=3

# 연성대학교 실제 학교코드(schlId)
YSU_UNIV_CODE=0002651

# ---- Frontend ----
# 브라우저는 Next rewrite(/api/backend/*) 경유. SSR/서버 컴포넌트는 이 값을 사용.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
